# Postgres + pgvector (matches docker-compose.yml)
POSTGRES_DB=report_qa
POSTGRES_USER=report_qa
POSTGRES_PASSWORD=report_qa
POSTGRES_PORT=5432
DATABASE_URL=postgresql://report_qa:report_qa@localhost:5432/report_qa

# SEC EDGAR requires a declared User-Agent with contact info for fair access.
# Format: "<app name> <your contact email>"
SEC_USER_AGENT="10k-analyst hugo@example.com"

# LLM used to write cited answers (Phase 3+).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local embedding model (Phase 2+), no API key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Jev / TypeSafe (Phase 2+). Leave JEV_API_KEY blank to keep using MockDecisionClient.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
